class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) {
        int n=nums.size();
        int sum=0;
        int  maxSum=0;
        int startIndex=0;
        int endIndex=k;
        
        for(int i=0;i<k;i++){
            sum+=nums[i];
        }
        maxSum=sum;
        while(endIndex < nums.size()){
            sum-=nums[startIndex];
            startIndex++;
            sum+=nums[endIndex];
            endIndex++;
            maxSum=max(maxSum,sum);
        }
        return (double)maxSum/k;
    }
};
